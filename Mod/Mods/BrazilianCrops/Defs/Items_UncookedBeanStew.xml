<!--
  Three uncooked bean stews, so that Kit's Brazilian Crops' stews go through the pot like every
  other stew instead of coming off the stove ready to eat.

  Shaped after VCE's own uncooked soups, def for def: RoughPlantBase, rots in four days and is
  destroyed, keeps an ingredient list, never eaten for nutrition, not tradeable, and the gourmet
  one is a VEF.Cooking.GourmetMeal.

  That last line is where the original mod would now fail. It gave the gourmet stew
  <li Class="VanillaCookingExpanded.CompProperties_StackByCondiments">, a class that exists in no
  version of VCE she has - it dates from the 1.3 assembly and was already gone by 1.4. It does not
  kill the def: Verse.CompProperties is concrete, so the loader falls back to it, logs, and
  attaches a comp that does nothing. VCE 1.6 does the same job with a thingClass instead, which is
  what is used here.

  The textures are the Stews add-on's, one step down the ladder each: a fine bean stew looks like
  a simple soup, lavish like fine, gourmet like lavish. Daemon976's choice, kept - the add-on ships
  three uncooked textures and there is no fourth to borrow.

  WorkToMake matches what Brazilian Crops' own cooked stews carry (450, 800, 1500), because its
  recipes set no workAmount and take their work from the product: putting the same number on the
  uncooked item leaves cooking time exactly where Brazilian Crops set it in 1.6. MarketValue is
  ten times the cooked stew's, since one uncooked stew becomes ten - the same ratio VCE uses for
  its soups.
-->
<Defs>

	<ThingDef ParentName="RoughPlantBase">
		<defName>KIT_UncookedStewFine</defName>
		<label>uncooked fine bean stew</label>
		<description>An uncooked fine bean stew. This needs to be cooked in an electric pot or a stew pot to be edible.</description>
		<graphicData>
			<texPath>Things/Items/UncookedStew/VCE_UncookedStewSimple</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>200</MarketValue>
			<Flammability>1.3</Flammability>
			<WorkToMake>450</WorkToMake>
			<Mass>4</Mass>
		</statBases>
		<thingSetMakerTags/>
		<tradeability>None</tradeability>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>4</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
			<li Class="CompProperties_Ingredients" />
		</comps>
		<thingCategories>
			<li>VCE_UncookedStews</li>
		</thingCategories>
		<ingestible>
			<preferability>NeverForNutrition</preferability>
		</ingestible>
	</ThingDef>

	<ThingDef ParentName="RoughPlantBase">
		<defName>KIT_UncookedStewLavish</defName>
		<label>uncooked lavish bean stew</label>
		<description>An uncooked lavish bean stew. This needs to be cooked in an electric pot or a stew pot to be edible.</description>
		<graphicData>
			<texPath>Things/Items/UncookedStew/VCE_UncookedStewFine</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>400</MarketValue>
			<Flammability>1.3</Flammability>
			<WorkToMake>800</WorkToMake>
			<Mass>4</Mass>
		</statBases>
		<thingSetMakerTags/>
		<tradeability>None</tradeability>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>4</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
			<li Class="CompProperties_Ingredients" />
		</comps>
		<thingCategories>
			<li>VCE_UncookedStews</li>
		</thingCategories>
		<ingestible>
			<preferability>NeverForNutrition</preferability>
		</ingestible>
	</ThingDef>

	<ThingDef ParentName="RoughPlantBase">
		<defName>KIT_UncookedStewGourmet</defName>
		<label>uncooked gourmet bean stew</label>
		<thingClass>VEF.Cooking.GourmetMeal</thingClass>
		<description>An uncooked gourmet bean stew. This needs to be cooked in an electric pot or a stew pot to be edible.</description>
		<graphicData>
			<texPath>Things/Items/UncookedStew/VCE_UncookedStewLavish</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>700</MarketValue>
			<Flammability>1.3</Flammability>
			<WorkToMake>1500</WorkToMake>
			<Mass>4</Mass>
		</statBases>
		<thingSetMakerTags/>
		<tradeability>None</tradeability>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>4</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
			<li Class="CompProperties_Ingredients" />
		</comps>
		<thingCategories>
			<li>VCE_UncookedStews</li>
		</thingCategories>
		<ingestible>
			<preferability>NeverForNutrition</preferability>
		</ingestible>
	</ThingDef>

</Defs>
