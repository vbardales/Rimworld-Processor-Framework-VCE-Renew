<?xml version="1.0" encoding="utf-8" ?>
<!--
  Daemon976's four soup processes, unchanged. Every def they name still exists in VCE 1.6 under
  the same name: the four uncooked soups and the four cooked ones.

  efficiency 10 with one uncooked soup in is ten cooked soups out, which is what VCE's own
  1.6 process does. processDays is half a day for simple against VCE's two - the original mod's
  balance choice, kept.
-->
<Defs>

  <ProcessorFramework.ProcessDef>
    <defName>VCE_CookedSoupSimple</defName>
    <thingDef>VCE_CookedSoupSimple</thingDef>
    <ingredientFilter>
      <thingDefs>
        <li>VCE_UncookedSoupSimple</li>
      </thingDefs>
    </ingredientFilter>
    <capacityFactor>1</capacityFactor>
    <efficiency>10.0</efficiency>
    <processDays>.5</processDays>
  </ProcessorFramework.ProcessDef>

  <ProcessorFramework.ProcessDef>
    <defName>VCE_CookedSoupFine</defName>
    <thingDef>VCE_CookedSoupFine</thingDef>
    <ingredientFilter>
      <thingDefs>
        <li>VCE_UncookedSoupFine</li>
      </thingDefs>
    </ingredientFilter>
    <capacityFactor>1</capacityFactor>
    <efficiency>10.0</efficiency>
    <processDays>.7</processDays>
  </ProcessorFramework.ProcessDef>

  <ProcessorFramework.ProcessDef>
    <defName>VCE_CookedSoupLavish</defName>
    <thingDef>VCE_CookedSoupLavish</thingDef>
    <ingredientFilter>
      <thingDefs>
        <li>VCE_UncookedSoupLavish</li>
      </thingDefs>
    </ingredientFilter>
    <capacityFactor>1</capacityFactor>
    <efficiency>10.0</efficiency>
    <processDays>1</processDays>
  </ProcessorFramework.ProcessDef>

  <ProcessorFramework.ProcessDef>
    <defName>VCE_CookedSoupGourmet</defName>
    <thingDef>VCE_CookedSoupGourmet</thingDef>
    <ingredientFilter>
      <thingDefs>
        <li>VCE_UncookedSoupGourmet</li>
      </thingDefs>
    </ingredientFilter>
    <capacityFactor>1</capacityFactor>
    <efficiency>10.0</efficiency>
    <processDays>1</processDays>
  </ProcessorFramework.ProcessDef>

</Defs>
